@model SweetBakery.Models.NguoiDung
@{
    ViewBag.Title = "Sửa Quản Trị Viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="admin-header-trang">
    <h2>✏️ Sửa Tài Khoản: @Model.HoTen</h2>
</div>

<div class="admin-khung-form">
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(m => m.MatKhau)

        <div class="luoi-2-cot-form">
            <div class="hang-nhap">
                @Html.LabelFor(m => m.HoTen)
                @Html.TextBoxFor(m => m.HoTen, new { @class = "admin-o-nhap" })
                @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "loi-nhap" })
            </div>
            <div class="hang-nhap">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "admin-o-nhap" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "loi-nhap" })
            </div>
        </div>

        <div class="luoi-2-cot-form">
            <div class="hang-nhap">
                @Html.LabelFor(m => m.SoDienThoai)
                @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "admin-o-nhap" })
                @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "loi-nhap" })
            </div>
            <div class="hang-nhap">
                @Html.LabelFor(m => m.DiaChi)
                @Html.TextBoxFor(m => m.DiaChi, new { @class = "admin-o-nhap" })
            </div>
        </div>

        <div class="hang-nhap">
            <label>Mật khẩu mới (bỏ trống nếu không đổi):</label>
            <input type="password" name="matKhauMoi" class="admin-o-nhap" placeholder="Tối thiểu 6 ký tự...">
            @Html.ValidationMessage("MatKhau", "", new { @class = "loi-nhap" })
        </div>

        <div style="margin-top: 20px; display: flex; gap: 10px;">
            <button type="submit" class="nut-bam">💾 Cập Nhật Tài Khoản</button>
            <a href="@Url.Action("Index")" class="nut-bam nut-bam-phu">&larr; Quay Lại</a>
        </div>
    }
</div>
