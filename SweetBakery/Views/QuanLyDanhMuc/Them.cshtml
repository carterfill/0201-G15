@model SweetBakery.Models.DanhMuc
@{
    ViewBag.Title = "Thêm Danh Mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="admin-header-trang">
    <h2>➕ Thêm Danh Mục Mới</h2>
</div>

<div class="admin-khung-form">
    @using (Html.BeginForm())
    {
        <div class="hang-nhap">
            @Html.LabelFor(m => m.TenDanhMuc)
            @Html.TextBoxFor(m => m.TenDanhMuc, new { @class = "admin-o-nhap", placeholder = "Ví dụ: Bánh Kem Sinh Nhật" })
            @Html.ValidationMessageFor(m => m.TenDanhMuc, "", new { @class = "loi-nhap" })
        </div>

        <div class="hang-nhap">
            @Html.LabelFor(m => m.MoTa)
            @Html.TextAreaFor(m => m.MoTa, new { @class = "admin-o-nhap", rows = 3, placeholder = "Mô tả ngắn về danh mục bánh..." })
            @Html.ValidationMessageFor(m => m.MoTa, "", new { @class = "loi-nhap" })
        </div>

        <div class="hang-nhap">
            @Html.LabelFor(m => m.HinhAnh)
            @Html.TextBoxFor(m => m.HinhAnh, new { @class = "admin-o-nhap", placeholder = "VD: croissant.jpg (ảnh đặt trong thư mục Content/images)" })
            @Html.ValidationMessageFor(m => m.HinhAnh, "", new { @class = "loi-nhap" })
        </div>

        <div style="margin-top: 20px; display: flex; gap: 10px;">
            <button type="submit" class="nut-bam">💾 Lưu Danh Mục</button>
            <a href="@Url.Action("Index")" class="nut-bam nut-bam-phu">&larr; Quay Lại</a>
        </div>
    }
</div>
