@model List<SweetBakery.Models.DonHang>
@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int? trangThaiLoc = ViewBag.TrangThaiLoc;
    int demChoXacNhan = ViewBag.DemChoXacNhan;
}
<div class="admin-header-trang">
    <h2>📦 Quản Lý Đơn Hàng</h2>
    @if (demChoXacNhan > 0)
    {
        <span class="admin-bao-cho-xac-nhan">🔔 Có @demChoXacNhan đơn đang chờ xác nhận</span>
    }
</div>

<div class="admin-thanh-cong-cu">
    <a href="@Url.Action("Index")" class="nut-bam nut-bam-nho @(trangThaiLoc == null ? "admin-dang-chon" : "nut-bam-phu")">Tất cả</a>
    <a href="@Url.Action("Index", new { trangThai = 1 })" class="nut-bam nut-bam-nho @(trangThaiLoc == 1 ? "admin-dang-chon" : "nut-bam-phu")">⏳ Chờ xác nhận</a>
    <a href="@Url.Action("Index", new { trangThai = 2 })" class="nut-bam nut-bam-nho @(trangThaiLoc == 2 ? "admin-dang-chon" : "nut-bam-phu")">🧑‍🍳 Đang làm bánh</a>
    <a href="@Url.Action("Index", new { trangThai = 3 })" class="nut-bam nut-bam-nho @(trangThaiLoc == 3 ? "admin-dang-chon" : "nut-bam-phu")">🚚 Đang giao</a>
    <a href="@Url.Action("Index", new { trangThai = 4 })" class="nut-bam nut-bam-nho @(trangThaiLoc == 4 ? "admin-dang-chon" : "nut-bam-phu")">✅ Đã giao</a>
    <a href="@Url.Action("Index", new { trangThai = 5 })" class="nut-bam nut-bam-nho @(trangThaiLoc == 5 ? "admin-dang-chon" : "nut-bam-phu")">❌ Đã hủy</a>
</div>

@if (Model.Count == 0)
{
    <p style="padding: 30px 0; color: var(--text-muted);">Không có đơn hàng nào ở trạng thái này.</p>
}
else
{
    <table class="admin-bang">
        <thead>
            <tr>
                <th>Mã Đơn</th>
                <th>Ngày Đặt</th>
                <th>Người Nhận</th>
                <th>SĐT</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th style="width: 200px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dh in Model)
            {
                string badgeTrangThai = "badge-cho-xac-nhan";
                string tenTrangThai = "Chờ xác nhận";
                if (dh.TrangThai == 2)
                {
                    badgeTrangThai = "badge-dang-lam";
                    tenTrangThai = "Đang làm bánh";
                }
                else if (dh.TrangThai == 3)
                {
                    badgeTrangThai = "badge-dang-giao";
                    tenTrangThai = "Đang giao";
                }
                else if (dh.TrangThai == 4)
                {
                    badgeTrangThai = "badge-da-giao";
                    tenTrangThai = "Đã giao";
                }
                else if (dh.TrangThai == 5)
                {
                    badgeTrangThai = "badge-da-huy";
                    tenTrangThai = "Đã hủy";
                }
                <tr>
                    <td><strong>#SB-@dh.MaDonHang</strong></td>
                    <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@dh.HoTenNguoiNhan</td>
                    <td>@dh.SoDienThoai</td>
                    <td><strong>@dh.TongTien.ToString("N0") đ</strong></td>
                    <td><span class="badge-trang-thai @badgeTrangThai">@tenTrangThai</span></td>
                    <td>
                        <a href="@Url.Action("ChiTiet", new { id = dh.MaDonHang })" class="nut-bam nut-bam-nho nut-sua">👁️ Xem</a>
                        @if (dh.TrangThai == 1)
                        {
                            <form action="@Url.Action("CapNhatTrangThai")" method="post" style="display: inline;">
                                <input type="hidden" name="id" value="@dh.MaDonHang">
                                <input type="hidden" name="trangThai" value="2">
                                <button type="submit" class="nut-bam nut-bam-nho">✅ Xác nhận</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
