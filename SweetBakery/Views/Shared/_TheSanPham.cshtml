@model SweetBakery.Models.SanPham

<div class="the-banh">
    <div class="khung-anh-banh">
        <a href="@Url.Action("ChiTiet", "SanPham", new { id = Model.MaSanPham })">
            <img src="~/Content/images/@Model.HinhAnh" alt="@Model.TenSanPham" loading="lazy">
        </a>
        @if (Model.GiaGoc.HasValue && Model.GiaGoc.Value > Model.Gia)
        {
            var phanTram = (int)Math.Round((1 - Model.Gia / Model.GiaGoc.Value) * 100);
            <span class="nhan-giam-gia">-@phanTram%</span>
        }
        @if (Model.Hot)
        {
            <span class="nhan-hot">🔥 Bán chạy</span>
        }
    </div>
    <div class="thong-tin-banh">
        <span class="the-danh-muc-nho">@Model.DanhMuc.TenDanhMuc</span>
        <h3><a href="@Url.Action("ChiTiet", "SanPham", new { id = Model.MaSanPham })">@Model.TenSanPham</a></h3>
        <div class="danh-gia-sao">
            <span class="sao">★★★★★</span>
            <span class="da-ban">Đã bán @Model.DaBan+</span>
        </div>
        <p class="mo-ta">@Model.MoTa</p>
        <div class="khung-gia-ban">
            <span class="gia-tien">@Model.Gia.ToString("N0") đ</span>
            @if (Model.GiaGoc.HasValue && Model.GiaGoc.Value > Model.Gia)
            {
                <span class="gia-goc">@Model.GiaGoc.Value.ToString("N0") đ</span>
            }
        </div>
        <div class="nhom-nut-the">
            <a href="@Url.Action("ChiTiet", "SanPham", new { id = Model.MaSanPham })" class="nut-xem-chi-tiet">Chi Tiết</a>
            <form action="@Url.Action("Them", "GioHang")" method="post" style="margin: 0;">
                <input type="hidden" name="id" value="@Model.MaSanPham">
                <input type="hidden" name="soLuong" value="1">
                <button type="submit" class="nut-bam nut-them-nhanh"><span>🛒 Thêm Giỏ</span></button>
            </form>
        </div>
    </div>
</div>
